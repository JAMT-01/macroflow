{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "macroflow",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-13",
  // nodejs_compat gives the Worker a native Buffer, used to base64 the meal
  // photo for OpenRouter inside the free plan's 10 ms CPU budget.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // No macroflow.<subdomain>.workers.dev route. A hostname-level gate such as
  // Cloudflare Access protects the custom domain only, so a live workers.dev
  // URL would be an unauthenticated way around it.
  "workers_dev": false,

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The Worker runs first for every path so the login gate covers the app
    // shell and the meal photos, not just the API. Signed-in requests fall
    // through to env.ASSETS.
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "macroflow",
      "database_id": "978a69cc-f981-4fa8-a136-c67b556bb643",
      "migrations_dir": "migrations"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "PHOTOS",
      "id": "cafdcdcb096c4b23b5978317a08a0fa1"
    }
  ],

  "triggers": {
    // Reminders are minute-accurate in the diary timezone, so the cron runs every minute.
    "crons": ["* * * * *"]
  },

  "vars": {
    "APP_URL": "https://jamtytrack.montagnertudor.org"
  },

  "routes": [
    {
      "pattern": "jamtytrack.montagnertudor.org",
      "custom_domain": true
    }
  ]
}
