# Create an API key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Best accuracy/cost balance in the bundled one-photo pilot. You can use any
# OpenRouter vision model that supports structured outputs.
OPENROUTER_MODEL=google/gemini-3.6-flash

# Used by links sent from Telegram. When opening Macroflow from your phone, use
# your computer's LAN address, for example http://192.168.1.20:5173.
APP_URL=http://localhost:5173
