{
  "name": "macroflow-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n worker,web -c green,cyan \"wrangler dev\" \"vite\"",
    "build": "pnpm check && vite build",
    "check": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "deploy": "pnpm build && wrangler deploy",
    "d1:migrate": "wrangler d1 migrations apply macroflow --remote",
    "d1:migrate:local": "wrangler d1 migrations apply macroflow --local",
    "bootstrap": "node scripts/bootstrap-dev.mjs",
    "d1:seed": "tsx scripts/generate-seed-migration.ts",
    "d1:export-local": "tsx scripts/export-local-to-d1.ts",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "hono": "^4.13.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260812.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^10.0.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.122.0"
  },
  "engines": {
    "node": ">=22"
  }
}
